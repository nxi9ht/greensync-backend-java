# === Database ===
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=project-green
# Keep true for the current fast local workflow. Production overrides this to false.
DB_SYNCHRONIZE=true

# === Authentication ===
# JWT_SECRET MUST be set in production to a strong random string (e.g., openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here

# === External APIs ===
# Gemini API Key for AI features
GEMINI_API_KEY=your_gemini_api_key_here

# === Security & Monitoring ===
# Set your allowed origins in production (e.g., https://yourdomain.com)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80
# API documentation remains available locally and is disabled by default in production.
ENABLE_SWAGGER=false

# Sentry DSN for error monitoring
# SENTRY_DSN=https://your_sentry_dsn_here

# === Payments (Stripe) ===
# Note: Stripe keys can also be configured via the Admin Settings UI in the application.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# === Email (SMTP) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# =====================================================================
# SECURITY NOTICE FOR PRODUCTION:
# Do not commit .env files to version control!
# In production, use GitHub Secrets, AWS Secrets Manager, or your PaaS 
# environment variable configuration to store these values.
# =====================================================================
